# Configuración del servidor backend para SaaS Entradas
PORT=4100
FRONT_URL=http://localhost:5174

# Conexión a PostgreSQL (Docker local por defecto)
# DATABASE_URL=postgres://saasuser:saaspassword@localhost:5432/saasentradas

# Secreto para firmar tokens JWT (Sesiones)
JWT_SECRET=tu-clave-secreta-larga-y-aleatoria

# Configuración de Stripe (Pasarela de pagos)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Envío de Emails (Resend)
# RESEND_API_KEY=re_...

# IA Asistente (Google Gemini AI Studio)
# GEMINI_API_KEY=...

# Procesamiento en segundo plano (Redis + BullMQ)
# REDIS_URL=redis://localhost:6379

# Monitorización (Opcional)
# SENTRY_DSN=
# LOG_LEVEL=info
